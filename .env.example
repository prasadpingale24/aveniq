AVENIQ_ENV=local
# Bind address for aveniq-api (use 0.0.0.0 in Docker)
AVENIQ_HOST=127.0.0.1
AVENIQ_PORT=8000
AVENIQ_SQLITE_PATH=.data/aveniq.db
FIXTURE_ROOT=fixtures
CONNECTOR_MODE=fixture
INVESTIGATION_RUN_ENABLED=true
LOG_LEVEL=INFO
CHECKOUT_STANDIN_URL=http://127.0.0.1:8081
PLAYGROUND_POLL_TIMEOUT_SEC=60
PLAYGROUND_POLL_INTERVAL_SEC=0.5
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
