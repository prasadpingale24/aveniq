# Copy to compose/.env.staging (gitignored). Used for compose interpolation AND API container env.
#
#   cp compose/.env.staging.example compose/.env.staging
#
# Generate secrets on the server (do not commit .env.staging):
#   openssl rand -base64 32    # AUTH_SESSION_SECRET
#   # AUTH_DEV_USERS: user:password — set via scripts/staging-init-env.sh or editor

AVENIQ_ENV=staging
AVENIQ_SQLITE_PATH=/data/aveniq.db
FIXTURE_ROOT=/app/fixtures
CONNECTOR_MODE=fixture
INVESTIGATION_RUN_ENABLED=true
LOG_LEVEL=INFO

# Host bind for API — host nginx proxies /api/ here (aveniq.pspworks.cloud)
AVENIQ_API_BIND=127.0.0.1
AVENIQ_API_PORT=8010

# Playground driver (in-process API path)
PLAYGROUND_POLL_TIMEOUT_SEC=60
PLAYGROUND_POLL_INTERVAL_SEC=0.5

# Session auth (M3 dev model on staging preview)
AUTH_ENABLED=true
AUTH_SESSION_SECRET=replace-with-openssl-rand-base64-32
AUTH_DEV_USERS=engineer:replace-with-strong-password
