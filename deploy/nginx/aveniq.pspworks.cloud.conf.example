# Host nginx — copy to /etc/nginx/sites-available/aveniq.pspworks.cloud
# Enable: sudo ln -s ... sites-enabled/
#
# Prerequisites:
#   - Static UI: /var/www/aveniq (scripts/staging-build-ui.sh)
#   - API on 127.0.0.1:8010 (compose/.env.staging AVENIQ_API_PORT)
#
# HTTP first, then: sudo certbot --nginx -d aveniq.pspworks.cloud

server {
    listen 80;
    listen [::]:80;
    server_name aveniq.pspworks.cloud;

    root /var/www/aveniq;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
